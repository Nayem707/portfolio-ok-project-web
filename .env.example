# App configuration
# Optional: set absolute backend URL for non-proxied environments.
# If omitted, frontend uses /api/v1 and Vite/dev proxy forwards to localhost:5000.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Optional media origin for relative `/uploads/...` paths.
# Defaults to the origin of VITE_API_BASE_URL when unset.
# VITE_MEDIA_BASE_URL=http://localhost:5000

# Firebase client (Google sign-in) — from Firebase Console → Project settings → Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
